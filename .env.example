# .env.example
# KD SOLUTION IT - environment variable template.
# Copy this file to ".env.local" for local development and never commit the copy.
#
# IMPORTANT - CONFIGURATION MODEL
# Only the variables in SECTION 1 and SECTION 2 are required to boot the
# application. Every integration credential (email, payment gateways, storage,
# messaging, analytics, e-commerce, monitoring) is managed at runtime from the
# super admin panel, is encrypted with AES-256 in the database, and takes effect
# within seconds without a rebuild or redeploy.
#
# Resolution order used by the application:
#   1. Encrypted value stored in the database (set from the admin panel)
#   2. Environment variable listed below (fallback)
#   3. Built in safe default
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Every other variable is server only and must never be exposed.

# =============================================================================
# SECTION 1 - APPLICATION (required)
# =============================================================================

# Public base URL of the application, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public product name shown in the interface and in emails.
NEXT_PUBLIC_APP_NAME=KD SOLUTION IT

# Short brand domain used to build client facing document links.
NEXT_PUBLIC_SHORT_LINK_URL=http://localhost:3000

# Runtime environment: development | test | production
APP_ENV=development

# =============================================================================
# SECTION 2 - SUPABASE (required - application bootstrap)
# =============================================================================
# These three values are the only credentials that cannot be managed from the
# admin panel, because they are used to reach the database itself.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server only. Bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL connection string, used by backup and restore scripts only.
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# =============================================================================
# SECTION 3 - ENCRYPTION (required - never rotate)
# =============================================================================
# 32 byte key, base64 encoded. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# WARNING: rotating this key makes every stored secret unreadable.
ENCRYPTION_KEY=generate-a-32-byte-base64-key

# Secret used to sign tokenised client document links.
# Generate with the same command as above.
LINK_SIGNING_SECRET=generate-a-32-byte-base64-secret

# Secret used for cross site request forgery protection.
CSRF_SECRET=generate-a-32-byte-base64-secret

# Shared secret required by scheduled job endpoints.
CRON_SECRET=generate-a-32-byte-base64-secret

# =============================================================================
# SECTION 4 - EMAIL (optional fallback - manage from Admin > Settings > Email)
# =============================================================================

RESEND_API_KEY=re_your_resend_api_key
RESEND_WEBHOOK_SECRET=your-resend-webhook-signing-secret
EMAIL_FROM_ADDRESS=support@kdsolutionit.com
EMAIL_FROM_NAME=KD SOLUTION IT
EMAIL_REPLY_TO=support@kdsolutionit.com

# SMTP fallback used when the Resend API is unavailable.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=your-smtp-password

# =============================================================================
# SECTION 5 - PAYMENT GATEWAYS (optional fallback - manage from Admin > Gateways)
# =============================================================================

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your-paddle-client-token
PADDLE_API_KEY=your-paddle-api-key
PADDLE_WEBHOOK_SECRET=your-paddle-webhook-secret

NMI_SECURITY_KEY=your-nmi-security-key
NMI_WEBHOOK_SECRET=your-nmi-webhook-secret

TWOCHECKOUT_MERCHANT_CODE=your-2checkout-merchant-code
TWOCHECKOUT_SECRET_KEY=your-2checkout-secret-key
TWOCHECKOUT_WEBHOOK_SECRET=your-2checkout-webhook-secret

# Adyen for Platforms (marketplace / sub-merchant routing).
ADYEN_API_KEY=your-adyen-api-key
ADYEN_MERCHANT_ACCOUNT=your-adyen-merchant-account
ADYEN_CLIENT_KEY=your-adyen-client-key
ADYEN_HMAC_KEY=your-adyen-webhook-hmac-key
ADYEN_ENVIRONMENT=test

# Nium (cross-border payout rail).
NIUM_API_KEY=your-nium-api-key
NIUM_CLIENT_HASH_ID=your-nium-client-hash-id
NIUM_WEBHOOK_SECRET=your-nium-webhook-secret
NIUM_ENVIRONMENT=sandbox

# Local payment rail 1 (kept generic in all user facing copy, see
# docs/planning/ARCHITECTURE-DECISIONS.md section 4).
LOCAL_RAIL_1_APP_KEY=your-local-rail-1-app-key
LOCAL_RAIL_1_APP_SECRET=your-local-rail-1-app-secret
LOCAL_RAIL_1_USERNAME=your-local-rail-1-username
LOCAL_RAIL_1_PASSWORD=your-local-rail-1-password

# Local payment rail 2.
LOCAL_RAIL_2_MERCHANT_ID=your-local-rail-2-merchant-id
LOCAL_RAIL_2_PUBLIC_KEY=your-local-rail-2-public-key
LOCAL_RAIL_2_PRIVATE_KEY=your-local-rail-2-private-key

# =============================================================================
# SECTION 6 - FILE STORAGE (optional fallback - manage from Admin > Storage)
# =============================================================================
# Supported providers: google_drive | supabase | r2 | s3 | b2 | wasabi | local
# Default provider: google_drive. Supabase Postgres stores only text and
# metadata (file id, link, mime type, size); every binary file (logos, KYC
# documents, receipts, attachments, generated PDFs) is stored in Google
# Drive. See docs/planning/ARCHITECTURE-DECISIONS.md section 7.
STORAGE_PROVIDER=google_drive

# Google Drive adapter (default storage provider). Service-account based
# access, one root folder with an auto-created sub-folder per company.
GOOGLE_DRIVE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY=your-service-account-private-key
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-root-folder-id

# Public base URL for optimised assets served through a CDN.
NEXT_PUBLIC_ASSET_BASE_URL=

# S3 compatible settings, used by the r2, s3, b2 and wasabi providers when a
# tenant or the platform switches away from the default Google Drive adapter.
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true

# =============================================================================
# SECTION 7 - MESSAGING CHANNELS (optional - manage from Admin > Channels)
# =============================================================================

WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-whatsapp-webhook-verify-token
WHATSAPP_API_VERSION=v26.0

SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
VIBER_AUTH_TOKEN=
VIBER_SENDER_NAME=

# =============================================================================
# SECTION 8 - SECURITY AND MONITORING (optional - manage from Admin > System)
# =============================================================================

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# =============================================================================
# SECTION 9 - MARKETING AND ANALYTICS (optional - manage from Admin > Marketing)
# =============================================================================

NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_CONTAINER_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# =============================================================================
# SECTION 10 - E-COMMERCE AND DATA SERVICES (optional - manage from Admin)
# =============================================================================

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
WOOCOMMERCE_WEBHOOK_SECRET=
BANK_FEED_PROVIDER_KEY=
OCR_PROVIDER_API_KEY=
