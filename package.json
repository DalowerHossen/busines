{
  "name": "kd-solution-it",
  "version": "0.1.0",
  "private": true,
  "description": "KD SOLUTION IT (PayProject) - Smart Billing for Modern Business. Multi-tenant invoicing, billing and subscription platform.",
  "license": "UNLICENSED",
  "author": "KD SOLUTION IT",
  "engines": {
    "node": ">=20.11.0 <23.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs,.cjs --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs,.cjs --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:language": "node scripts/check-language.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "verify": "npm run check:language && npm run check:placeholders && npm run typecheck && npm run lint && npm run format:check",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.1",
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.46.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "decimal.js": "10.4.3",
    "lucide-react": "0.454.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.2",
    "server-only": "0.0.1",
    "sonner": "1.7.0",
    "tailwind-merge": "2.5.4",
    "tailwindcss-animate": "1.0.7",
    "zod": "3.23.8",
    "zustand": "5.0.1"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@commitlint/cli": "19.5.0",
    "@commitlint/config-conventional": "19.5.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "9.1.0",
    "husky": "9.1.7",
    "lint-staged": "15.2.10",
    "postcss": "8.4.49",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.8",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
