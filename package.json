{
  "name": "kd-solution-it",
  "version": "0.1.0",
  "private": true,
  "description": "KD SOLUTION IT (PayProject) - Smart Billing for Modern Business. Multi-tenant invoicing, billing and subscription platform.",
  "license": "UNLICENSED",
  "author": "KD SOLUTION IT",
  "engines": {
    "node": ">=20.11.0 <23.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs,.cjs --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs,.cjs --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:language": "node scripts/check-language.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "verify": "npm run check:language && npm run check:placeholders && npm run typecheck && npm run verify:phase47 && npm run verify:phase48 && npm run lint && npm run format:check",
    "verify:ecommerce": "tsx scripts/verify-ecommerce-signatures.ts && tsx scripts/verify-ecommerce-normalization.ts",
    "verify:security": "tsx scripts/verify-security.ts",
    "verify:mor": "tsx scripts/verify-mor.ts",
    "verify:accounting": "tsx scripts/verify-accounting.ts",
    "verify:core": "tsx scripts/verify-core.ts",
    "verify:phase35": "tsx scripts/verify-phase35.ts",
    "verify:phase36": "tsx scripts/verify-phase36.ts",
    "verify:phase37": "tsx scripts/verify-phase37.ts",
    "verify:phase38": "tsx scripts/verify-phase38.ts",
    "verify:phase39": "tsx scripts/verify-phase39.ts",
    "verify:phase40": "tsx scripts/verify-phase40.ts",
    "verify:phase41": "tsx scripts/verify-phase41.ts",
    "verify:phase42": "tsx scripts/verify-phase42.ts",
    "verify:phase43": "tsx scripts/verify-phase43.ts",
    "verify:phase44": "tsx scripts/verify-phase44.ts",
    "verify:phase45": "tsx scripts/verify-phase45.ts",
    "verify:phase17": "tsx scripts/verify-phase17.ts",
    "verify:phase18": "tsx scripts/verify-phase18.ts",
    "verify:phase19": "tsx scripts/verify-phase19.ts",
    "verify:phase20": "tsx scripts/verify-phase20.ts",
    "verify:phase21": "tsx scripts/verify-phase21.ts",
    "verify:phase22": "tsx scripts/verify-phase22.ts && node scripts/verify-phase22-render.mjs",
    "verify:phase23": "tsx scripts/verify-phase23.ts && node scripts/verify-phase23-live.mjs",
    "verify:phase24": "tsx scripts/verify-phase24.ts",
    "verify:phase46": "tsx scripts/verify-phase46.ts",
    "verify:phase47": "tsx scripts/verify-phase47.ts",
    "prepare": "husky",
    "verify:phase48": "tsx scripts/verify-phase48.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.1",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csv-parse": "^7.0.3",
    "date-fns": "3.6.0",
    "decimal.js": "10.4.3",
    "exceljs": "^4.4.0",
    "googleapis": "^183.0.0",
    "jszip": "^3.10.2",
    "lucide-react": "0.454.0",
    "next": "15.5.24",
    "pdf-lib": "^1.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.2",
    "sanitize-html": "^2.18.0",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "sonner": "1.7.0",
    "tailwind-merge": "3.4.0",
    "zod": "3.23.8",
    "zustand": "5.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "autoprefixer": "10.6.1",
    "eslint": "10.12.0",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.6.3",
    "vitest": "5.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "uuid": "11.1.1",
    "postcss-selector-parser": "7.1.6",
    "glob": "10.5.0",
    "postcss": "8.5.29"
  }
}
