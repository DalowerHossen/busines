# docker/Dockerfile.dev
# Development image with hot reload. Mounts the repository as a volume via
# docker-compose.yml so source edits on the host are picked up immediately.

FROM node:20.18.0-alpine
WORKDIR /app
RUN apk add --no-cache libc6-compat

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1
EXPOSE 3000

CMD ["npm", "run", "dev"]
